.env.example # Example environment variables for Free-Telegram-Store-Bot

# IMPORTANT: Rotate your Telegram BOT token now (do NOT use the token you previously posted publicly)
BOT_TOKEN=8866813743:AAFldrzv-Rl3IVCXiVYccBm3KWVMEQyFccU
ADMIN_TELEGRAM_ID=6505578903
ADMIN_TELEGRAM_USERNAME=novainintelligence-tech

# Postgres database credentials for docker-compose (change before production)
POSTGRES_USER=botuser
POSTGRES_PASSWORD=change_me_now
POSTGRES_DB=botdb
# Database URL used by SQLAlchemy. When running with docker-compose, use the service name 'db'
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Manual payment receiving addresses (set your real addresses here)
PAYMENT_BTC_ADDRESS=1EqgNKJMmnnWpGjYZJAapDEyyXruXxLCYj
PAYMENT_USDT_TRC20_ADDRESS=TZADiUxhu9Y5bvJUMbMtBgFW43KqQ1hzaD
PAYMENT_USDC_ADDRESS=0xfe601096668c46d4bb0bd4e3c93751a3a8f4b3e5

# Automatic confirmation settings
AUTO_CONFIRM=true  # Set to true to enable automatic verification (requires provider keys below)
INFURA_URL=  # Ethereum RPC (Infura / Alchemy). Required for USDC (ERC-20) automatic checks.
TRONGRID_API_KEY=  # TronGrid API key for TRC20 (USDT) automatic checks.
BTC_API_KEY=  # Optional BTC provider API key (BlockCypher / Blockchair) or leave empty to use public APIs

# CryptoBot integration (optional). Leave empty to disable CryptoBot-based invoices.
CRYPTO_BOT_API_KEY=

# Telegram Payments (Card) provider token (optional)
TELEGRAM_PROVIDER_TOKEN=
PAYMENT_CURRENCY=USD

# Application settings
PAYMENT_EXPIRY_HOURS=0.5
PAYMENT_CHECK_INTERVAL=30

# Directories
ASSETS_DIR=assets
LOGOS_DIR=${ASSETS_DIR}/logos
PRODUCTS_DIR=${ASSETS_DIR}/products

# Notes:
# - Do NOT commit this file with real secrets to your repository. Use a secure secrets manager or CI/CD secret store.
# - After editing this file, copy it to .env locally or inject the values into your deployment environment.
